<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/rippleColor">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#F20D1D2D" android:endColor="#E608131E" />
            <stroke android:width="1dp" android:color="#8555B9FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>

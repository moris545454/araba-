<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/rippleColor">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="48dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_focused="true">
                <shape>
                    <solid android:color="?attr/colorSecondaryVariant" />
                    <stroke android:width="2dp" android:color="?attr/colorAccent" />
                    <corners android:radius="48dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <gradient android:angle="315" android:startColor="?attr/colorPrimarySurface" android:endColor="?attr/colorSecondary" />

                    <corners android:radius="48dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

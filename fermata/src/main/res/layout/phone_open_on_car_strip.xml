<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/phone_open_on_car_strip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:colorPrimary"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp"
    android:visibility="gone">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/phone_header_utility"
        android:layout_width="0dp"
        android:layout_height="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/phone_header_aa_group"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/phone_header_aa_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/phone_header_aa_dot"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/phone_header_aa_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/phone_header_open_on_car_group"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_open_on_car_strip_title"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorPrimary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/phone_open_on_car_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/phone_open_on_car_strip_title" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- One compact row: artwork, title and the transport keys. The full player stays in the
         bottom control panel, so this header no longer covers half of the phone screen. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/phone_header_summary"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/phone_header_utility">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/phone_header_artwork"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/colorPrimarySurface"
            android:contentDescription="@null"
            android:padding="6dp"
            android:scaleType="centerCrop"
            android:src="@drawable/audiotrack"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/phone_header_metadata"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/phone_header_transport"
            app:layout_constraintStart_toEndOf="@id/phone_header_artwork"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/phone_header_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/phone_header_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/phone_header_transport"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/phone_header_previous"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/focusable_shape_transparent"
                android:contentDescription="@string/action_prev"
                android:padding="11dp"
                android:src="@drawable/prev"
                app:tint="?attr/colorOnPrimary" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/phone_header_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/aa_play_button_bg"
                android:contentDescription="@string/action_play"
                android:padding="11dp"
                android:src="@drawable/play"
                app:tint="?android:attr/colorBackground" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/phone_header_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/focusable_shape_transparent"
                android:contentDescription="@string/action_next"
                android:padding="11dp"
                android:src="@drawable/next"
                app:tint="?attr/colorOnPrimary" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Seeking lives in the bottom control panel; kept for the controller, never shown. -->
    <SeekBar
        android:id="@+id/phone_header_progress"
        style="?attr/appSeekBarStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/phone_header_summary" />

    <LinearLayout
        android:id="@+id/phone_header_times"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/phone_header_summary">

        <TextView
            android:id="@+id/phone_header_elapsed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/phone_header_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dashboard_tile_height"
    android:layout_margin="@dimen/dashboard_card_margin"
    android:background="@drawable/dashboard_launch_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/dashboard_tile_height"
    android:padding="0dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/dashboard_hero_art"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="1"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="H,340:141"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/dashboard_item_icon"
        android:visibility="gone"
        android:layout_width="@dimen/dashboard_tile_icon_size"
        android:layout_height="@dimen/dashboard_tile_icon_size"
        android:contentDescription="@null"
        android:padding="@dimen/dashboard_tile_icon_padding"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSecondary" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/dashboard_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="2"
        android:textSize="26sp"
        android:textColor="#FFFFFFFF"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:textAppearance="?attr/textAppearanceListItem"
		app:layout_constraintEnd_toStartOf="@id/dashboard_item_edit_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dashboard_hero_art"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="0dp"
        app:layout_goneMarginEnd="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="16dp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/dashboard_item_subtitle"
        android:layout_marginEnd="62dp"
        android:layout_width="0dp"
		android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="2"
        android:textSize="@dimen/dashboard_tile_subtitle_size"
        android:alpha="0.85"
        android:textAppearance="?android:attr/textAppearanceSmall"
		android:textColor="#FFAFB7C4"
		android:layout_marginTop="5dp"
        app:layout_constraintEnd_toStartOf="@id/dashboard_item_edit_actions"
        app:layout_constraintStart_toStartOf="@id/dashboard_item_title"
        app:layout_constraintTop_toBottomOf="@id/dashboard_item_title"
        app:layout_goneMarginEnd="0dp" />

    <TextView
        android:id="@+id/dashboard_hero_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="@string/playback_live"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/media_hub_live_badge"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/dashboard_item_icon" />

    <LinearLayout
        android:id="@+id/dashboard_item_actions"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/dashboard_action_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/focusable_shape_transparent"
            android:contentDescription="@string/action_play_pause"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/play_pause"
            app:tint="?attr/colorOnSecondary" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/dashboard_action_favorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/focusable_shape_transparent"
            android:contentDescription="@string/favorites_add"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/favorite"
            app:tint="?attr/colorOnSecondary" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/dashboard_action_back_to_list"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/focusable_shape_transparent"
            android:contentDescription="@string/dashboard_back_to_list"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/view_list"
            app:tint="?attr/colorOnSecondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dashboard_item_edit_actions"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/dashboard_action_move_earlier"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/focusable_shape_transparent"
            android:contentDescription="@string/move_left"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/move_left"
            app:tint="?attr/colorOnSecondary" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/dashboard_action_move_later"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/focusable_shape_transparent"
            android:contentDescription="@string/move_right"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/move_right"
            app:tint="?attr/colorOnSecondary" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/dashboard_hero_arrow"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="22dp"
        android:padding="12dp"
        android:background="@drawable/dashboard_hero_arrow_bg"
        android:visibility="visible"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/chevron_right"
        app:tint="#FFFFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

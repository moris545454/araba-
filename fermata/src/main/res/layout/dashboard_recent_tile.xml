<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="148dp"
    android:layout_height="160dp"
    android:layout_marginEnd="10dp"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/dashboard_launch_card_bg"
    android:focusable="true"
    android:clickable="true">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/dashboard_recent_art"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/dem_recent_art_bg"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />
    <TextView
        android:id="@+id/dashboard_recent_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />
    <TextView
        android:id="@+id/dashboard_recent_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary" />
</LinearLayout>
